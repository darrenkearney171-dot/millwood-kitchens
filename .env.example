# Millwood Kitchens — Environment Variables
# Copy this file to .env and replace placeholder values.
# These values need to be manually inserted into the HTML files
# (there is no build system to inject them automatically).

# Formspree form endpoints
# Sign up at https://formspree.io and create two forms
FORMSPREE_ESTIMATE_ID=your_estimate_form_id_here
FORMSPREE_CONTACT_ID=your_contact_form_id_here

# Stripe
# Create a Payment Link at https://dashboard.stripe.com/payment-links
# for £150 "Kitchen Design Visit" with success redirect to Calendly
STRIPE_PAYMENT_LINK=https://buy.stripe.com/your_link_here

# Calendly
# Sign up at https://calendly.com (Pro plan needed for Stripe integration)
# Create event: "Kitchen Design Visit — £150", 3-hour duration
CALENDLY_URL=https://calendly.com/your_username/kitchen-design-visit
CALENDLY_EMBED_URL=https://calendly.com/your_username/kitchen-design-visit?embed_type=inline

# Domain
SITE_URL=https://millwoodkitchens.uk
